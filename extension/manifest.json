{
  "manifest_version": 3,
  "name": "Hayye Market",
  "version": "4.2.0",
  "description": "75+ Türkiye mağazası ve etkinlik/bilet sitesinde kalıcı Yan Panel, Görsel Fiyat Seçici, 2. El Yeni İlan Farkı Nöbeti, canlı sahte indirim kontrolü ve beden stoğu.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "sidePanel", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:47821/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Hayye Market Yan Panelini Aç",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon32.png", "icons/icon48.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.zara.com/*", "https://*.bershka.com/*", "https://*.stradivarius.com/*",
        "https://*.pullandbear.com/*", "https://*.massimodutti.com/*", "https://*.oysho.com/*",
        "https://*.mango.com/*", "https://*.hm.com/*", "https://*.flawwear.com/*",
        "https://*.hypetr.com/*", "https://*.36clo.com/*", "https://*.nike.com/*",
        "https://*.adidas.com.tr/*", "https://*.puma.com/*", "https://*.newbalance.com.tr/*",
        "https://*.superstep.com.tr/*", "https://*.sneaksup.com/*", "https://*.fashfed.com/*",
        "https://*.wunder.com.tr/*", "https://*.lesbenjamins.com/*", "https://*.beymen.com/*",
        "https://*.boyner.com.tr/*", "https://*.mavi.com/*", "https://*.koton.com/*",
        "https://*.decathlon.com.tr/*", "https://*.kostebek.com.tr/*", "https://*.carpe.com.tr/*",
        "https://*.sephora.com.tr/*", "https://*.gratis.com/*", "https://*.watsons.com.tr/*",
        "https://*.rossmann.com.tr/*", "https://*.eveshop.com.tr/*", "https://*.kikomilano.com.tr/*",
        "https://*.ikea.com.tr/*", "https://*.karaca.com/*", "https://*.dyson.com.tr/*",
        "https://*.sahibinden.com/*", "https://*.dolap.com/*", "https://*.letgo.com/*",
        "https://*.gardrops.com/*", "https://*.trendyol.com/*", "https://*.hepsiburada.com/*",
        "https://*.n11.com/*", "https://*.pazarama.com/*", "https://*.idefix.com/*",
        "https://*.amazon.com.tr/*", "https://*.itopya.com/*", "https://*.incehesap.com/*",
        "https://*.sinerji.gen.tr/*", "https://*.gaming.gen.tr/*", "https://*.tebilon.com/*",
        "https://*.gamegaraj.com/*", "https://*.qpbilisim.com.tr/*", "https://*.teknosa.com/*",
        "https://*.mediamarkt.com.tr/*", "https://*.akakce.com/*", "https://*.vatanbilgisayar.com/*",
        "https://*.bubilet.com.tr/*", "https://*.mobilet.com/*", "https://*.biletinial.com/*",
        "https://*.biletix.com/*", "https://*.biletino.com/*", "https://*.passo.com.tr/*",
        "https://*.paribucineverse.com/*", "https://*.paribupass.com/*", "https://*.zorlupsm.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
