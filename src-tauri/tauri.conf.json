{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hayye Market",
  "version": "4.3.1",
  "identifier": "com.metehan.hayye-market",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hayye Market // Fiyat, Stok & 2. El İstihbarat Terminali",
        "width": 1480,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#080A0D"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
